# OpenAI API Key
OPENAI_API_KEY=

# Railway API Key (Optional, requested by user)
RAILWAY_API_KEY=

# OpenAI Model to use (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# System Prompt to guide the chatbot personality
SYSTEM_PROMPT=Sen yardımsever bir yapay zeka asistanısın. WhatsApp üzerinden gelen sorulara net ve samimi cevaplar verirsin.

# Port for Web Interface (automatically injected by Railway)
PORT=3000
